datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


enum Currency {
  USD
  NGN
  GBP
  EUR
}

model User {
  id        Int     @default(autoincrement()) @id
  fullname  String?
  email     String  @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  accounts Account[]
  conversionHistories ConversionHistory[]

  @@map("users")
}



model Account {
  id    Int     @default(autoincrement()) @id
  userId Int
  currency Currency
  balance Float @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([currency])

  @@map("accounts")
}

model ConversionHistory {
  id    Int     @default(autoincrement()) @id
  userId Int
  fromCurrency Currency
  toCurrency Currency
  rate Float
  amount Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  user User @relation(fields: [userId], references: [id])

  @@map("conversion_histories")
}